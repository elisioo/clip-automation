# Copy this to .env and paste your own Groq key. Never share the .env file.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional fallback if you prefer OpenAI (leave blank to use Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# If false, saves Groq calls; uses keywords only for discovery ranking
KINROOT_METADATA_AI=true

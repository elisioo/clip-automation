    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const task = $('Get clip task from website').first().json;\nconst items = $input.all().flatMap(x => Array.isArray(x.json) ? x.json : (Array.isArray(x.json.items) ? x.json.items : [x.json]));\nconst out=[];\nfor (const a of items) {\n const url= a.url || a.pinUrl || '';\n if (!url || !(a.isVideo === true || a.videoUrl)) continue;\n out.push({json:{job_id:task.job_id,clip_id:task.clip_id,platform:'Pinterest',source_url:url,video_url:a.videoUrl||'',title:a.title||'',description:a.description||a.altText||'',status:'candidate_found'}});\n}\nreturn out.length ? out.slice(0,3) : [{json:{job_id:task.job_id,clip_id:task.clip_id,platform:'Pinterest',status:'no_results',error:items.find(x=>x.error)?.error?.message||'No video candidates'}}];"
      },

        "jsCode": "const task=$('Get clip task from website').first().json;\nconst raws=$input.all();const out=[];\nfor (const item of raws) {\n  for (const v of (item.json.items||[])) {\n    const vid=v.id?.videoId;if(!vid)continue;\n    out.push({json:{job_id:task.job_id,clip_id:task.clip_id,platform:'YouTube',\n      source_url:'https://www.youtube.com/watch?v='+vid,video_url:'',\n      title:v.snippet?.title||'',description:v.snippet?.description||'',\n      status:'candidate_found'}});\n  }\n}\nreturn out.length ? out.slice(0,3) : [{json:{job_id:task.job_id,clip_id:task.clip_id,platform:'YouTube',status:'no_results',error:'No videos or quota/auth issue'}}];"
